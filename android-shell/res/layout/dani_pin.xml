<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="8dp">
    <LinearLayout
        android:id="@+id/pn_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">
        <Chronometer
            android:id="@+id/pn_chr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="30sp"
            android:fontFamily="sans-serif-light"
            android:layoutDirection="ltr"
            style="@android:style/TextAppearance.Material.Notification.Title" />
        <TextView
            android:id="@+id/pn_tt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="30sp"
            android:fontFamily="sans-serif-light"
            style="@android:style/TextAppearance.Material.Notification.Title" />
        <TextView
            android:id="@+id/pn_nm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end"
            style="@android:style/TextAppearance.Material.Notification" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
    <LinearLayout
        android:id="@+id/pn_s1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">
            <ImageView
                android:id="@+id/pn_c1"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/dani_pin_circle" />
            <TextView
                android:id="@+id/pn_e1"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:textSize="20sp"
                android:textColor="#FFFFFF" />
        </FrameLayout>
        <TextView
            android:id="@+id/pn_l1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:maxWidth="64dp"
            style="@android:style/TextAppearance.Material.Notification" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/pn_s2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">
            <ImageView
                android:id="@+id/pn_c2"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/dani_pin_circle" />
            <TextView
                android:id="@+id/pn_e2"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:textSize="20sp"
                android:textColor="#FFFFFF" />
        </FrameLayout>
        <TextView
            android:id="@+id/pn_l2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:maxWidth="64dp"
            style="@android:style/TextAppearance.Material.Notification" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/pn_s3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">
            <ImageView
                android:id="@+id/pn_c3"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/dani_pin_circle" />
            <TextView
                android:id="@+id/pn_e3"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:textSize="20sp"
                android:textColor="#FFFFFF" />
        </FrameLayout>
        <TextView
            android:id="@+id/pn_l3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:maxWidth="64dp"
            style="@android:style/TextAppearance.Material.Notification" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/pn_s4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">
            <ImageView
                android:id="@+id/pn_c4"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/dani_pin_circle" />
            <TextView
                android:id="@+id/pn_e4"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:textSize="20sp"
                android:textColor="#FFFFFF" />
        </FrameLayout>
        <TextView
            android:id="@+id/pn_l4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:maxWidth="64dp"
            style="@android:style/TextAppearance.Material.Notification" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/pn_s5"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">
            <ImageView
                android:id="@+id/pn_c5"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/dani_pin_circle" />
            <TextView
                android:id="@+id/pn_e5"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:textSize="20sp"
                android:textColor="#FFFFFF" />
        </FrameLayout>
        <TextView
            android:id="@+id/pn_l5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:maxWidth="64dp"
            style="@android:style/TextAppearance.Material.Notification" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/pn_s6"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">
            <ImageView
                android:id="@+id/pn_c6"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/dani_pin_circle" />
            <TextView
                android:id="@+id/pn_e6"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:textSize="20sp"
                android:textColor="#FFFFFF" />
        </FrameLayout>
        <TextView
            android:id="@+id/pn_l6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:maxWidth="64dp"
            style="@android:style/TextAppearance.Material.Notification" />
    </LinearLayout>
    </LinearLayout>
</LinearLayout>
